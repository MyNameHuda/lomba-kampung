# Session encryption key — required in production, must be 32+ chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=replace_me_with_random_32plus_chars_xxxxxxxxxxxx

# libSQL / Turso connection
# Local dev: leave empty → defaults to file:./lomba.db
# Production: libsql://your-db.turso.io
NUXT_DATABASE_URL=
NUXT_DATABASE_AUTH_TOKEN=
