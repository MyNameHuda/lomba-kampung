# =================================================================
# Lomba Kampung — Environment Variables
# =================================================================
# Copy this file to `.env.local` for local dev.
# For Vercel production, set these in Project Settings → Environment Variables.

# --- Required in production ---

# Cookie/session encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters. App throws on boot if missing/short in production.
SESSION_PASSWORD=replace_me_with_a_random_64_char_hex_string_here_xx

# --- Database (Turso + local fallback) ---

# Turso connection URL. Format: libsql://<db-name>-<org>.turso.io
# Get it after running: turso db create lomba-kampung
# Leave empty in dev to use the local file ./lomba.db
DATABASE_URL=

# Turso auth token. Generate with: turso db tokens create lomba-kampung
# Leave empty in dev (file: URL doesn't need auth).
DATABASE_AUTH_TOKEN=

# --- Optional / dev-only ---

# Override default admin password during initial seed.
#   ADMIN_PASSWORD=mysecret  node lib/db/seed.cjs
# Default: lomba123 (change in production via /admin/pengaturan)
ADMIN_PASSWORD=lomba123

# Port for `next dev` / `next start`. Default: 3000.
PORT=3000
