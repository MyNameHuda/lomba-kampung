{
  "name": "lomba-kampung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "db:seed": "node lib/db/seed.cjs",
    "db:push": "node lib/db/migrate.cjs",
    "db:reset": "node -e \"const fs=require('fs');try{fs.rmSync('lomba.db',{force:true});fs.rmSync('lomba.db-wal',{force:true});fs.rmSync('lomba.db-shm',{force:true});console.log('DB deleted')}catch(e){console.log('no local DB to delete')}\" && node lib/db/seed.cjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "iron-session": "^8.0.3",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
